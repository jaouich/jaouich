    <string name="live_help_twitch">Twitch: Creator Dashboard › Settings › Stream › Primary stream key. Copy it here.</string>
    <string name="live_help_custom">Any RTMP or RTMPS server (TikTok Live, Instagram via a partner tool, your own server…). Enter the server address and the key.</string>
