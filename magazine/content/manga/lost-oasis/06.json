{"n": 6, "title": "سر الساحر", "date": "2026-11-25", "card": {"id": "sun", "pitch": "الشمس الذهبية كانت سبب جفاف الواحة في الحكاية. بطاقة الشمس خرافية: ثلاث نسخ فقط في كل Pi Oasis، وسعر مَكِّنها مرتفع وهو لا يضمن أي ربح."}, "panels": [{"scene": "castle", "note": "التنين يتكلم", "chars": [{"who": "jerry", "x": 110, "y": 165, "s": 1, "e": "surprised"}, {"who": "nour", "x": 290, "y": 155, "s": 0.95, "e": "surprised", "flip": true}], "bubbles": [{"x": 200, "y": 40, "text": "لن تمرّوا إلا بجواب", "shout": true}]}, {"scene": "night", "note": "اللغز", "chars": [{"who": "wizard", "x": 200, "y": 150, "s": 1.05, "e": "calm"}], "bubbles": [{"x": 200, "y": 40, "text": "فجأة ظهر الساحر|وأوقف التنين", "tail": [200, 95]}]}, {"scene": "castle", "note": "الساحر يعترف", "chars": [{"who": "wizard", "x": 110, "y": 155, "s": 1, "e": "sad"}, {"who": "jerry", "x": 290, "y": 160, "s": 0.95, "e": "surprised", "flip": true}], "bubbles": [{"x": 110, "y": 40, "text": "أنا من أخفى الماء", "tail": [110, 100]}, {"x": 290, "y": 255, "text": "أنت؟ لماذا؟"}]}, {"scene": "night", "note": "السبب", "chars": [{"who": "wizard", "x": 200, "y": 150, "s": 1.05, "e": "sad"}], "bubbles": [{"x": 200, "y": 40, "text": "كانت الواحة تضيّع الماء|فخبأته لأحميها", "tail": [200, 95]}]}, {"scene": "oasis", "note": "جيري يفكر", "chars": [{"who": "jerry", "x": 110, "y": 165, "s": 1, "e": "calm"}, {"who": "nour", "x": 290, "y": 150, "s": 0.95, "e": "calm", "flip": true}], "bubbles": [{"x": 110, "y": 40, "text": "الماء لا يُحمى|بإخفائه عن الجميع", "tail": [110, 100]}, {"x": 290, "y": 255, "text": "بل بتقاسمه"}]}, {"scene": "desert", "note": "الساحر يتردد", "chars": [{"who": "wizard", "x": 200, "y": 150, "s": 1.05, "e": "calm"}], "bubbles": [{"x": 200, "y": 40, "text": "ربما كنتُ مخطئًا...", "tail": [200, 95]}]}, {"scene": "oasis", "note": "نور تتحدث للقراء", "chars": [{"who": "nour", "x": 200, "y": 150, "s": 1.05, "e": "happy"}], "bubbles": [{"x": 200, "y": 40, "text": "هل تعرفون بطاقة الشمس؟|ثلاث نسخ فقط!", "tail": [200, 95]}]}, {"scene": "desert", "note": "وصف البطاقة", "chars": [{"who": "nour", "x": 110, "y": 155, "s": 1, "e": "happy"}, {"who": "jerry", "x": 290, "y": 160, "s": 0.95, "e": "happy", "flip": true}], "bubbles": [{"x": 110, "y": 40, "text": "نادرة جدًا وسعرها مرتفع|ولا تعد بأرباح", "tail": [110, 100]}, {"x": 290, "y": 255, "text": "لعبة وهواية فقط"}, {"x": 200, "y": 290, "text": "يتبع في الفصل السابع", "shout": true}]}]}